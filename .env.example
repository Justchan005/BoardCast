# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.5-flash          # use the newest Flash model available to you

# --- Backend (Cloud Run) ---
PUBLIC_BASE_URL=https://boardcast-api-xxxx.a.run.app
API_AUDIENCE=https://boardcast-api-xxxx.a.run.app
POSTER_BUCKET=your-project-id-posters
PUBSUB_TOPIC_SUBMITTED=item-submitted
BQ_AUDIT_TABLE=your-project-id.boardcast.audit_log
AGENT_SERVICE_ACCOUNT=boardcast-agent@your-project-id.iam.gserviceaccount.com
SCHEDULER_SERVICE_ACCOUNT=boardcast-scheduler@your-project-id.iam.gserviceaccount.com
ALLOWED_LINK_DOMAINS=forms.gle,docs.google.com,forms.office.com,apu.edu.my,instagram.com,www.instagram.com
GMAIL_TOKEN_JSON=                      # from Secret Manager, never commit
LINK_SECRET=                           # long random string; signs unsubscribe/preference links
OAUTH_CLIENT_ID=                       # Google Identity Services web client id for /admin sign-in
DEV_MODE=false                         # true only on your laptop (lets /admin use a dev email)
AUDIT_DISABLED=false                   # true for offline eval runs

# --- Pre-review agent and cost estimates ---
PREREVIEW_AUTO=true                    # false = only the "Run pre-review" button starts the agent
PREREVIEW_TEMPERATURE=                 # empty = the model's default
# US$ per one million tokens for GEMINI_MODEL, copied from the official pricing page.
# Empty = the run trace and insights show token counts without a cost.
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=

# --- Agent ---
BOARDCAST_API_URL=https://boardcast-api-xxxx.a.run.app
DEV_USER_EMAIL=                        # local testing only

# --- Local laptop run (no Google Cloud) ---
# LOCAL_MODE=true stores data in local_data/db.json, posters in local_data/posters,
# and writes emails to local_data/outbox/*.html instead of sending them. Implies DEV_MODE.
LOCAL_MODE=false
# Gemini on a laptop: an Agent Platform API key ("AQ." prefix, Cloud console > Agent Platform >
# API keys) with GOOGLE_GENAI_USE_VERTEXAI=TRUE and GOOGLE_CLOUD_PROJECT/LOCATION left unset,
# or an AI Studio key with GOOGLE_GENAI_USE_VERTEXAI=FALSE. Without a key, extraction is
# unavailable and the Editor falls back to a plain plan.
GEMINI_API_KEY=

# --- Teams bot (teams/bot.py) ---
TEAMS_BOT_ID=                          # bot app id from Teams Developer Portal > Bot management
TEAMS_BOT_SECRET=                      # its client secret (Secret Manager on Cloud Run)
TEAMS_TENANT_ID=                       # APU's tenant id; messages from other tenants are refused
TEAMS_LOCAL=false                      # true only on a laptop with the Agents Playground
